  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/islobodan/cruncher-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/islobodan/cruncher-mcp/issues"
  },
  "homepage": "https://github.com/islobodan/cruncher-mcp#readme"
