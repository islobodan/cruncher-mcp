{
  "name": "@slbdn/cruncher-mcp",
  "version": "1.2.26",
  "description": "Zero-dependency scientific calculator MCP server with strict validation, worker isolation, and 43 tools across 8 categories",
  "main": "cruncher.js",
  "type": "commonjs",
  "bin": {
    "cruncher-mcp": "./cruncher.js",
    "cruncher": "./cruncher.js"
  },
  "scripts": {
    "start": "node cruncher.js",
    "test": "npx tsx tests/test-cruncher-full.ts",
    "test:quick": "node cruncher.test.js",
    "check-syntax": "node -c cruncher.js",
    "prepublishOnly": "npm run check-syntax && npm test"
  },
  "keywords": [
    "mcp",
    "ai",
    "llm",
    "calculator",
    "math",
    "scientific",
    "statistics",
    "unit-conversion",
    "model-context-protocol",
    "model-context-protocol-server",
    "zero-dependencies"
  ],
  "author": "Slobodan Ivkovic",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/islobodan/cruncher-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/islobodan/cruncher-mcp/issues"
  },
  "homepage": "https://github.com/islobodan/cruncher-mcp#readme",
  "files": [
    "cruncher.js",
    "cruncher.test.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "mcp": {
    "schema": "1.0"
  },
  "devDependencies": {
    "@slbdn/mcp-tester": "^1.1.0"
  }
}
